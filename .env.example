APP_ENV=prod
APP_URL=0.0.0.0
APP_PORT=8080
APP_GRPC_PORT=50051
APP_VERSION=1.0.0

AUTH_SERVICE=https://api.psychometrist.local/v1/auth

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://dashboard.psychometrist.local,https://api.psychometrist.local

DB_URI=127.0.0.1:3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meet_db
DB_USER=meet_user
DB_PASSWORD=root
DB_SSL_CA=/etc/mysql/ssl/ca-cert.pem
DB_SSL_KEY=/etc/mysql/ssl/client-key.pem
DB_SSL_CERT=/etc/mysql/ssl/client-cert.pem
DB_SSL_VERIFY=false

LOG_LEVEL=error
LOG_PATH=storage/logs

# Docker/Container Registry
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_NAME=psychometrist/meet

# Auth Service
AUTH_SERVICE_URL=http://localhost:8081

# Set to true ONLY for a local, non-public instance - skips the auth service
# entirely and treats every request as a fully-privileged local caller. Never
# set this in staging/production.
AUTH_DISABLED=false

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json