APP_ENV=prod
APP_URL=0.0.0.0
# Must match the ports hardcoded in docker-compose.prod.yml ("8083:8083",
# "9093:9093") — the container listens on whatever these are set to, so a
# different value here leaves the published host port pointing at nothing.
APP_PORT=8083
APP_GRPC_PORT=9093
APP_VERSION=1.0.0

AUTH_SERVICE=https://api.psychometrist.local/v1/auth

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://dashboard.psychometrist.local,https://api.psychometrist.local

DB_URI=127.0.0.1:3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meet_db
DB_USER=meet_user
DB_PASSWORD=root
DB_SSL_CA=/etc/mysql/ssl/ca-cert.pem
DB_SSL_KEY=/etc/mysql/ssl/client-key.pem
DB_SSL_CERT=/etc/mysql/ssl/client-cert.pem
DB_SSL_VERIFY=false

LOG_LEVEL=error
LOG_PATH=storage/logs

# Docker/Container Registry
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_NAME=psychometrist/meet

# Set to true ONLY for a local, non-public instance - skips the auth service
# entirely and treats every request as a fully-privileged local caller. Never
# set this in staging/production.
AUTH_DISABLED=false

# Gooyai (AI phone receptionist) integration. Each clinic saves its own API key
# and sandbox/prod choice in the dashboard (Settings -> Booking Settings).
GOOYAI_BASE_URL=https://api.gooyai.ir
# Encrypts the clinics' Gooyai keys at rest: base64 of exactly 32 random bytes,
# e.g. `openssl rand -base64 32`. Unset = integration disabled; a malformed value
# stops the service from starting. Rotating it makes stored keys unreadable, so
# clinics would need to re-enter theirs. A secret - keep the real one out of git.
GOOYAI_ENCRYPTION_KEY=
